# RozgarSetu AI — Environment Configuration

# Local SQLite (default for development):
# DATABASE_URL="file:./rozgarsetu.db"

# Hosted libSQL / Turso database (for serverless deployments like Vercel / Cloudflare):
# TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Eligibility explanation with LLM (Strict Rule: EXPLAIN_WITH_LLM=false by default)
# Core eligibility engine ALWAYS runs purely deterministically without LLM.
EXPLAIN_WITH_LLM=false

# Optional Gemini API key (only active if EXPLAIN_WITH_LLM=true)
# GEMINI_API_KEY=""
